  {
    "id": "anim_6",
    "title": "Плавающее окно: обход двумя указателями",
    "code": "s = \"AAB\"\nmax_len = 0\nleft = 0\nfor right in range(len(s)):\n    if s[right] == 'A':\n        left = right + 1\n    else:\n        max_len = max(max_len, right - left + 1)\nprint(max_len)",
    "variables": ["s", "left", "right", "max_len"],
    "steps": [
      {"line": 0, "vars": {"s": "\"AAB\"", "left": "0", "right": "-", "max_len": "0"}, "explanation": "Создаем строку s."},
      {"line": 1, "vars": {"s": "\"AAB\"", "left": "0", "right": "-", "max_len": "0"}, "explanation": "max_len = 0."},
      {"line": 2, "vars": {"s": "\"AAB\"", "left": "0", "right": "-", "max_len": "0"}, "explanation": "left = 0 — левая граница окна."},
      {"line": 3, "vars": {"s": "\"AAB\"", "left": "0", "right": "0", "max_len": "0"}, "explanation": "right начинает двигаться вправо, сейчас right = 0."},
      {"line": 4, "vars": {"s": "\"AAB\"", "left": "0", "right": "0", "max_len": "0"}, "explanation": "s[0] == 'A'. Условие истинно."},
      {"line": 5, "vars": {"s": "\"AAB\"", "left": "1", "right": "0", "max_len": "0"}, "explanation": "left сдвигается за символом 'A': left = 0 + 1 = 1."},
      {"line": 3, "vars": {"s": "\"AAB\"", "left": "1", "right": "1", "max_len": "0"}, "explanation": "right = 1."},
      {"line": 4, "vars": {"s": "\"AAB\"", "left": "1", "right": "1", "max_len": "0"}, "explanation": "s[1] == 'A'. Условие истинно."},
      {"line": 5, "vars": {"s": "\"AAB\"", "left": "2", "right": "1", "max_len": "0"}, "explanation": "left = 1 + 1 = 2."},
      {"line": 3, "vars": {"s": "\"AAB\"", "left": "2", "right": "2", "max_len": "0"}, "explanation": "right = 2."},
      {"line": 4, "vars": {"s": "\"AAB\"", "left": "2", "right": "2", "max_len": "0"}, "explanation": "s[2] == 'B'. Условие ложно, идем в else."},
      {"line": 6, "vars": {"s": "\"AAB\"", "left": "2", "right": "2", "max_len": "0"}, "explanation": "Ветка else."},
      {"line": 7, "vars": {"s": "\"AAB\"", "left": "2", "right": "2", "max_len": "1"}, "explanation": "Длина окна: 2 - 2 + 1 = 1. max(0, 1) = 1."},
      {"line": 3, "vars": {"s": "\"AAB\"", "left": "2", "right": "-", "max_len": "1"}, "explanation": "right дошел до конца строки, цикл завершен."},
      {"line": 8, "vars": {"s": "\"AAB\"", "left": "2", "right": "-", "max_len": "1"}, "explanation": "Выводим результат: 1."}
    ]
  },
