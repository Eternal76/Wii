  {
    "id": "anim_1",
    "title": "Поиск максимальной длины без символа 'X'",
    "code": "s = \"ABCXABCABC\"\nmax_len = 0\ncurrent = 0\nfor c in s:\n    if c != 'X':\n        current += 1\n    else:\n        if current > max_len:\n            max_len = current\n        current = 0\nif current > max_len:\n    max_len = current\nprint(max_len)",
    "variables": ["s", "c", "current", "max_len"],
    "steps": [
      {"line": 0, "vars": {"s": "\"ABCXABCABC\"", "c": "-", "current": "0", "max_len": "0"}, "explanation": "Инициализация строки s."},
      {"line": 1, "vars": {"s": "\"ABCXABCABC\"", "c": "-", "current": "0", "max_len": "0"}, "explanation": "Создаем переменную для максимума."},
      {"line": 2, "vars": {"s": "\"ABCXABCABC\"", "c": "-", "current": "0", "max_len": "0"}, "explanation": "Создаем счетчик текущей длины."},
