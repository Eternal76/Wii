  {
    "id": "anim_3",
    "title": "Поиск самой длинной цепочки одинаковых символов",
    "code": "s = \"AABBB\"\nmax_len = 0\ncur = 1\nfor i in range(1, len(s)):\n    if s[i] == s[i-1]:\n        cur += 1\n    else:\n        if cur > max_len:\n            max_len = cur\n        cur = 1\nif cur > max_len:\n    max_len = cur\nprint(max_len)",
    "variables": ["s", "i", "s[i]", "cur", "max_len"],
    "steps": [
      {"line": 0, "vars": {"s": "\"AABBB\"", "i": "-", "s[i]": "-", "cur": "1", "max_len": "0"}, "explanation": "Инициализация строки."},
      {"line": 1, "vars": {"s": "\"AABBB\"", "i": "-", "s[i]": "-", "cur": "1", "max_len": "0"}, "explanation": "max_len = 0."},
      {"line": 2, "vars": {"s": "\"AABBB\"", "i": "-", "s[i]": "-", "cur": "1", "max_len": "0"}, "explanation": "cur = 1 (первый символ уже образует цепочку длины 1)."},
      {"line": 3, "vars": {"s": "\"AABBB\"", "i": "1", "s[i]": "A", "cur": "1", "max_len": "0"}, "explanation": "Цикл начинается с i=1 (второй символ)."},
      {"line": 4, "vars": {"s": "\"AABBB\"", "i": "1", "s[i]": "A", "cur": "1", "max_len": "0"}, "explanation": "s[1] == s[0] ('A' == 'A'). Условие истинно."},
      {"line": 5, "vars": {"s": "\"AABBB\"", "i": "1", "s[i]": "A", "cur": "2", "max_len": "0"}, "explanation": "cur увеличивается до 2."},
      {"line": 3, "vars": {"s": "\"AABBB\"", "i": "2", "s[i]": "B", "cur": "2", "max_len": "0"}, "explanation": "Следующий индекс i=2."},
      {"line": 4, "vars": {"s": "\"AABBB\"", "i": "2", "s[i]": "B", "cur": "2", "max_len": "0"}, "explanation": "s[2] == s[1] ('B' == 'A'). Ложно."},
      {"line": 6, "vars": {"s": "\"AABBB\"", "i": "2", "s[i]": "B", "cur": "2", "max_len": "0"}, "explanation": "Идем в else."},
      {"line": 7, "vars": {"s": "\"AABBB\"", "i": "2", "s[i]": "B", "cur": "2", "max_len": "0"}, "explanation": "cur (2) > max_len (0)."},
      {"line": 8, "vars": {"s": "\"AABBB\"", "i": "2", "s[i]": "B", "cur": "2", "max_len": "2"}, "explanation": "max_len становится 2."},
      {"line": 9, "vars": {"s": "\"AABBB\"", "i": "2", "s[i]": "B", "cur": "1", "max_len": "2"}, "explanation": "cur сбрасывается в 1 (для символа 'B')."},
      {"line": 3, "vars": {"s": "\"AABBB\"", "i": "3", "s[i]": "B", "cur": "1", "max_len": "2"}, "explanation": "Следующий индекс i=3."},
      {"line": 4, "vars": {"s": "\"AABBB\"", "i": "3", "s[i]": "B", "cur": "1", "max_len": "2"}, "explanation": "s[3] == s[2] ('B' == 'B'). Истинно."},
      {"line": 5, "vars": {"s": "\"AABBB\"", "i": "3", "s[i]": "B", "cur": "2", "max_len": "2"}, "explanation": "cur становится 2."},
      {"line": 3, "vars": {"s": "\"AABBB\"", "i": "4", "s[i]": "B", "cur": "2", "max_len": "2"}, "explanation": "Следующий индекс i=4."},
      {"line": 4, "vars": {"s": "\"AABBB\"", "i": "4", "s[i]": "B", "cur": "2", "max_len": "2"}, "explanation": "s[4] == s[3] ('B' == 'B'). Истинно."},
      {"line": 5, "vars": {"s": "\"AABBB\"", "i": "4", "s[i]": "B", "cur": "3", "max_len": "2"}, "explanation": "cur становится 3."},
      {"line": 3, "vars": {"s": "\"AABBB\"", "i": "-", "s[i]": "-", "cur": "3", "max_len": "2"}, "explanation": "Цикл завершен."},
      {"line": 10, "vars": {"s": "\"AABBB\"", "i": "-", "s[i]": "-", "cur": "3", "max_len": "2"}, "explanation": "Проверка после цикла."},
      {"line": 11, "vars": {"s": "\"AABBB\"", "i": "-", "s[i]": "-", "cur": "3", "max_len": "3"}, "explanation": "3 > 2, обновляем максимум."},
      {"line": 12, "vars": {"s": "\"AABBB\"", "i": "-", "s[i]": "-", "cur": "3", "max_len": "3"}, "explanation": "Выводим 3."}
    ]
